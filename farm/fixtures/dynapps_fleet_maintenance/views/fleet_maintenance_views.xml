<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_maintenance_tree" model="ir.ui.view">
        <field name="name">dynapps.fleet.maintenance.tree</field>
        <field name="model">dynapps.fleet.maintenance</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="service_type_id"/>
                <field name="scheduled_date"/>
                <field name="cost" sum="Total"/>
                <field name="is_overdue" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fleet_maintenance_form" model="ir.ui.view">
        <field name="name">dynapps.fleet.maintenance.form</field>
        <field name="model">dynapps.fleet.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_done" type="object" string="Mark Done"
                            attrs="{'invisible': [('state', '!=', 'scheduled')]}"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            states="scheduled,done"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,done"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="service_type_id"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="done_date" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                            <field name="odometer"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fleet_maintenance_search" model="ir.ui.view">
        <field name="name">dynapps.fleet.maintenance.search</field>
        <field name="model">dynapps.fleet.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter name="filter_scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('state', '!=', 'done'), ('scheduled_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fleet_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Orders</field>
        <field name="res_model">dynapps.fleet.maintenance</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_fleet_maintenance" name="Maintenance Orders"
              parent="fleet.fleet_vehicles" action="action_fleet_maintenance" sequence="40"/>
</odoo>
