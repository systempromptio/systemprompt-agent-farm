<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_maintenance_scheduled" model="mail.template">
            <field name="name">Fleet Maintenance: Scheduled</field>
            <field name="model_id" ref="model_dynapps_fleet_maintenance"/>
            <field name="subject">Maintenance scheduled for {{ object.vehicle_id.name }}</field>
            <field name="email_to">{{ object.driver_id.email }}</field>
            <field name="body_html" type="html">
                <p>Hello <t t-out="object.driver_id.name or ''"/>,</p>
                <p>Your vehicle <t t-out="object.vehicle_id.name"/> is booked for
                <t t-out="object.service_type_id.name"/> on <t t-out="object.scheduled_date"/>.</p>
            </field>
        </record>
    </data>
</odoo>
